<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AzureNotificationHubs.Community</PackageId>
    <Version>5.0.0</Version>
    <Authors>AzureNotificationHubs.Community contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SummaticLtd/azure-notificationhubs-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SummaticLtd/azure-notificationhubs-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      Unofficial community fork of Microsoft.Azure.NotificationHubs, the .NET client for Azure Notification Hubs back end operations.

      Native AOT compatible, with no Newtonsoft.Json or DataContractSerializer dependency and retired platforms removed. The namespace and assembly name are unchanged.
    </Description>
    <PackageReleaseNotes>https://github.com/SummaticLtd/azure-notificationhubs-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>© Microsoft Corporation. © AzureNotificationHubs.Community contributors.</Copyright>
    <PackageTags>Azure NotificationHubs NotificationHub Notifications Push AOT Windows iOS Android Baidu Kindle Amazon</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Azure.NotificationHubs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SRClient.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SRClient.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="SRClient.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SRClient.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
